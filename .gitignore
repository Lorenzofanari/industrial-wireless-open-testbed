# Generated experiment outputs (keep folder structure + READMEs/placeholders)
results/*
!results/README.md
!results/.gitkeep
!results/metrics/
!results/figures/
!results/manifests/
results/metrics/*
results/figures/*
results/manifests/*
results/demo/
!results/metrics/.gitkeep
!results/figures/.gitkeep
!results/manifests/.gitkeep

# Raw captures are never committed by default (use owned/authorised interfaces)
*.pcap
*.pcapng

# OS / editor
.DS_Store
.idea/
.vscode/
